# Copia este archivo a .env (local) o cargá estas variables en el hosting. No subas valores reales a Git.

# Base PostgreSQL (obligatoria)
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/BASE?schema=public&sslmode=require"

# Fotos de la comunidad y del catálogo (Cloudinary). Opcional en el sitio de muestra.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Dirección pública del sitio, sin barra final. Se usa en las imágenes al compartir y en la verificación de origen.
NEXT_PUBLIC_SITE_URL="https://tu-dominio.com"
COMMUNITY_ORIGIN="https://tu-dominio.com"

# Código de verificación de Google Search Console (opcional).
# GOOGLE_SITE_VERIFICATION="codigo-de-google"

# Solo detrás de un proxy confiable que reemplaza X-Forwarded-For (por ejemplo Vercel).
COMMUNITY_TRUST_PROXY=1

# SOLO en el sitio de muestra: cartel, sin buscadores, sin subir fotos y base obligatoriamente "demo".
# DEMO_MODE=1
